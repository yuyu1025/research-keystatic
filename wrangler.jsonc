{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-keystatic",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG": "yuyu1025-research-keystatic",
    "R2_PUBLIC_BASE_URL": "https://file.research.distinctive.fun"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "research"
      // 本地要写真实桶：加 "remote": true，并 wrangler login
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "research.distinctive.fun/console*",
      "zone_name": "distinctive.fun"
    },
    {
      "pattern": "research.distinctive.fun/keystatic*",
      "zone_name": "distinctive.fun"
    },
    {
      "pattern": "research.distinctive.fun/api/keystatic*",
      "zone_name": "distinctive.fun"
    },
    {
      "pattern": "research.distinctive.fun/api/homepage*",
      "zone_name": "distinctive.fun"
    },
    {
      "pattern": "research.distinctive.fun/studio*",
      "zone_name": "distinctive.fun"
    },
    {
      "pattern": "research.distinctive.fun/assets*",
      "zone_name": "distinctive.fun"
    },
    {
      "pattern": "research.distinctive.fun/api/assets*",
      "zone_name": "distinctive.fun"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "research-keystatic"
    }
  ]
}

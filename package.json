{
  "name": "research-keystatic",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://research.distinctive.fun",
  "packageManager": "pnpm@10.15.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.js",
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.js",
    "build:worker": "opennextjs-cloudflare build && node scripts/prefix-worker-assets.js",
    "preview": "pnpm build:worker && opennextjs-cloudflare preview",
    "deploy": "pnpm build:worker && opennextjs-cloudflare deploy",
    "setup:github-app": "node scripts/setup-github-app.mjs",
    "start": "next start",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@keystar/ui": "~0.10.0",
    "@keystatic/core": "^0.6.7",
    "@keystatic/next": "^5.0.5",
    "@markdoc/markdoc": "^0.4.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "next": "~15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.7.3",
    "wrangler": "^4.134.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}

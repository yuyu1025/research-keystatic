# Keystatic GitHub App。本地：.env.local / .dev.vars；线上：Cloudflare Worker secrets。
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# 公开访问域名。线上走 wrangler.jsonc vars，不必当 secret。
# 桶本身用 wrangler.jsonc 的 r2_buckets 绑定 MEDIA，不要再配 S3 密钥。
# R2_PUBLIC_BASE_URL=https://file.research.distinctive.fun
